# Copiá este archivo como .env.local y completá lo que uses. El equipo, los modelos y las
# herramientas de cada agente se eligen en oficina.config.ts; acá van las claves y los topes.
# Sin ANTHROPIC_API_KEY, el modo Agentes no hace ninguna llamada y no gasta nada.

# Clave de la API de Anthropic: console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=

# Tope de gasto por mes en dólares. Si no lo ponés, son 5.
AI_OFFICE_BUDGET_USD=5

# Para el agente con tools.githubRepos: un token fine-grained con Contents: Read en los repos
# que quieras que lea. Sin él, ese agente propone sin ver el código.
# AI_OFFICE_GITHUB_TOKEN=

# Tope de cada sesión de ese agente en dólares. Si no lo ponés, es 1. Aparta el doble del tope mensual.
# AI_OFFICE_REPO_SESSION_USD=1

# Tokens de los servidores MCP: una variable por cada tokenEnv de oficina.config.ts.
# MCP_TAREAS_TOKEN=

# Para cambiar de modelo sin tocar oficina.config.ts. Pisa al de la configuración.
# Opciones con precio cargado: claude-opus-5-5, claude-sonnet-5-5 y claude-haiku-5-5.
# AI_OFFICE_MODEL=claude-sonnet-5-5
# Uno por agente, con su id en mayúsculas (los guiones van como _):
# AI_OFFICE_MODEL_DIRECCION=claude-opus-5-5

# Sólo en el servidor. Sin esta contraseña, de 12 caracteres o más, la oficina no abre online.
# AI_OFFICE_PASSWORD=

# Dónde se guardan entregas y gasto. Con un volumen de Railway no hace falta: lo encuentra sola.
# AI_OFFICE_DATA_DIR=/data
